  "info": {
    "title": "TrustTrace API",
    "description": "Müşteri hizmetleri chat platformu",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": { "bearer": { "scheme": "bearer", "bearerFormat": "JWT", "type": "http" } },
    "schemas": {
      "UserRole": { "type": "string", "enum": ["CUSTOMER", "AGENT", "ADMIN"] },
      "UserStatus": { "type": "string", "enum": ["ACTIVE", "SUSPENDED", "BANNED"] },
      "UserResponseDto": {
        "type": "object",
        "properties": {
          "role": { "allOf": [{ "$ref": "#/components/schemas/UserRole" }] },
          "status": { "allOf": [{ "$ref": "#/components/schemas/UserStatus" }] },
          "id": { "type": "string" },
          "email": { "type": "string" },
          "displayName": { "type": "string" },
          "suspendedUntil": { "format": "date-time", "type": "string", "nullable": true }
        },
        "required": ["role", "status", "id", "email", "displayName", "suspendedUntil"]
      },
      "AdminUserResponseDto": {
        "type": "object",
        "properties": {
          "role": { "allOf": [{ "$ref": "#/components/schemas/UserRole" }] },
          "status": { "allOf": [{ "$ref": "#/components/schemas/UserStatus" }] },
          "id": { "type": "string" },
          "email": { "type": "string" },
          "displayName": { "type": "string" },
          "suspendedUntil": { "format": "date-time", "type": "string", "nullable": true },
          "isOnline": { "type": "boolean" }
        },
        "required": ["role", "status", "id", "email", "displayName", "suspendedUntil", "isOnline"]
      },
      "ModerationEventType": {
        "type": "string",
        "enum": ["VIOLATION_DETECTED", "SANCTION_IMPOSED", "SANCTION_REVOKED"]
      },
      "ModerationActorType": { "type": "string", "enum": ["SYSTEM", "ADMIN"] },
      "ModerationEventResponseDto": {
        "type": "object",
        "properties": {
          "eventType": { "allOf": [{ "$ref": "#/components/schemas/ModerationEventType" }] },
          "actorType": { "allOf": [{ "$ref": "#/components/schemas/ModerationActorType" }] },
          "payload": { "type": "object", "additionalProperties": true },
          "seq": { "type": "number" },
          "id": { "type": "string" },
          "actorId": { "type": "string", "nullable": true },
          "subjectUserId": { "type": "string" },
          "roomId": { "type": "string", "nullable": true },
          "messageId": { "type": "string", "nullable": true },
          "refersToEventId": { "type": "string", "nullable": true },
          "occurredAt": { "format": "date-time", "type": "string" }
        },
        "required": [
          "eventType",
          "actorType",
          "payload",
          "seq",
          "id",
          "actorId",
          "subjectUserId",
          "roomId",
          "messageId",
          "refersToEventId",
          "occurredAt"
        ]
      },
      "AuthResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": { "type": "string" },
          "accessTokenExpiresIn": { "type": "number" },
          "refreshToken": { "type": "string" },
          "user": { "$ref": "#/components/schemas/UserResponseDto" }
        },
        "required": ["accessToken", "accessTokenExpiresIn", "refreshToken", "user"]
      },
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": { "type": "string", "maxLength": 254, "format": "email" },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 72,
            "pattern": "^(?=.*[A-Za-z])(?=.*\\d).+$"
          },
          "displayName": { "type": "string", "minLength": 2, "maxLength": 80 }
        },
        "required": ["email", "password", "displayName"]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": { "type": "string", "maxLength": 254, "format": "email" },
          "password": { "type": "string", "minLength": 1, "maxLength": 72 }
        },
        "required": ["email", "password"]
      },
      "RefreshTokenDto": {
        "type": "object",
